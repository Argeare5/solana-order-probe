# Copy to .env and fill in. No keys here: keypairs are mounted from ./secrets.

# JSON-RPC and WebSocket endpoints. The public endpoint works for recon and dry-runs; measurements need a provider
# plan with enough getBlock and WebSocket capacity. The slot clock is precise only when the WebSocket offers
# slotsUpdatesSubscribe (first-shred timestamps); otherwise it falls back to notification arrival times.
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Hard cap on fees spent by live runs, in SOL (the bounty allows about 0.05)
SPEND_CAP_SOL=0.05

# Leaders measured by `docker compose up` (comma-separated identities)
TARGETS=HEL1USMZKAL2odpNBj2oCjffnFGaYwmbGmyewGv1e2TU,Fd7btgySsrjuo25CJCj7oE7VPMyezDhnx7pZkj2v69Nk,EvnRmnMrd69kFdbLMxWkTn1icZ7DCceRhvmb2SJXqDo4
